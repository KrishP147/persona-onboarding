# Agent brain (required for real replies; without it the app runs in mock mode)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5

# Voice pipeline (Pipecat lane)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Media parsing
GROQ_API_KEY=
GEMINI_API_KEY=

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Deploy-time session store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
