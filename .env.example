# Agent brain: Gemini is used when its key is set; without any key the app runs in mock mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# fallback order when a model is out of free quota (comma separated)
# GEMINI_AGENT_CHAIN=gemini-2.5-flash,gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Optional insurance: if every gemini model is out of free quota, answer with claude instead,
# capped at LLM_FALLBACK_DAILY_TURNS turns a day (needs ANTHROPIC_API_KEY below).
# LLM_FALLBACK=anthropic
# LLM_FALLBACK_DAILY_TURNS=60
# LLM_FALLBACK_TOTAL_TURNS=120
# Anthropic alternative (set LLM_PROVIDER=anthropic to prefer it)
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
FAST_MODEL=claude-haiku-4-5

# Voice pipeline (Pipecat lane)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Testing only: the harness's simulated users and grader (free trial key; never used by the demo)
COHERE_API_KEY=
# Unused for now
GROQ_API_KEY=

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Deploy-time session store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# harness only: lets test runs send gmail_connected with an email (never set in production)
# ALLOW_TEST_EVENTS=1
